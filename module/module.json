{
    "key": "module_cleaner",
    "name": "Longlink Module Cleaner",
    "version": "0.1.0g",
    "description": "Inventory, plan, audit, and safely orchestrate addon module residue cleanup through host-owned purge primitives.",
    "runtime": {
        "provider": "Modules\\ModuleCleaner\\ModuleCleanerModuleProvider"
    },
    "autoload": {
        "psr-4": {
            "Modules\\ModuleCleaner\\": "src/"
        }
    },
    "owned_tables": [
        "module_cleaner_cleanup_logs"
    ],
    "database_migrations": [
        "2026_06_13_020000_create_module_cleaner_cleanup_logs_table"
    ],
    "permissions": [
        "module_cleaner.view",
        "module_cleaner.plan",
        "module_cleaner.purge"
    ],
    "routes": [
        {
            "method": "GET",
            "path": "/admin/module-cleaner",
            "name": "admin.module-cleaner.index"
        },
        {
            "method": "GET",
            "path": "/admin/module-cleaner/registry",
            "name": "admin.module-cleaner.registry"
        },
        {
            "method": "GET",
            "path": "/admin/module-cleaner/modules/{module}",
            "name": "admin.module-cleaner.modules.show"
        },
        {
            "method": "GET",
            "path": "/admin/module-cleaner/modules/{module}/plan",
            "name": "admin.module-cleaner.modules.plan.show"
        },
        {
            "method": "POST",
            "path": "/admin/module-cleaner/modules/{module}/plan",
            "name": "admin.module-cleaner.modules.plan"
        },
        {
            "method": "GET",
            "path": "/admin/module-cleaner/orphans",
            "name": "admin.module-cleaner.orphans"
        },
        {
            "method": "GET",
            "path": "/admin/module-cleaner/backups",
            "name": "admin.module-cleaner.backups"
        },
        {
            "method": "GET",
            "path": "/admin/module-cleaner/quarantine",
            "name": "admin.module-cleaner.quarantine"
        },
        {
            "method": "GET",
            "path": "/admin/module-cleaner/logs",
            "name": "admin.module-cleaner.logs"
        },
        {
            "method": "GET",
            "path": "/admin/module-cleaner/settings",
            "name": "admin.module-cleaner.settings"
        },
        {
            "method": "POST",
            "path": "/admin/module-cleaner/settings",
            "name": "admin.module-cleaner.settings.update"
        }
    ],
    "menus": [
        "platform_tools.module_cleaner"
    ],
    "ownership": {
        "tables": [
            "module_cleaner_cleanup_logs"
        ],
        "permission_keys": [
            "module_cleaner.view",
            "module_cleaner.plan",
            "module_cleaner.purge"
        ],
        "settings_keys": [],
        "storage_paths": [
            "modules/module_cleaner"
        ]
    },
    "cleanup": {
        "default_mode": "quarantine",
        "requires_backup": true,
        "requires_step_up_mfa": true,
        "allow_hard_delete": false,
        "retain_audit_logs": true,
        "safe_to_delete_tables": [
            "module_cleaner_cleanup_logs"
        ]
    },
    "requires_host_min_version": "0.7.9d-CX",
    "notes": [
        "0.1.0g replaces the Cleaner console button strip with host responsive category links and mobile Categories Menu behaviour.",
        "0.1.0f exposes Cleaner as a Platform Tools console with dashboard, registry, module details, dry-run plans, orphan tables, backups, quarantine, logs, and settings views.",
        "0.1.0f keeps purge execution dry-run/host-primitive only while surfacing the full cleanup workflow structure for review and future gated execution.",
        "0.1.0e renames package inventory SQL aliases away from MariaDB reserved words to prevent the admin dashboard 500 on MySQL/MariaDB hosts.",
        "0.1.0d fixes the admin cleaner route shell to use the host app-shell component and shared token-backed UI primitives.",
        "Populate release. This module inventories ownership snapshots and creates dry-run cleanup plans through the host AddonModuleRegistry only.",
        "Owned data is restricted to module_cleaner_* tables and module-owned storage. Core settings, permissions, navigation rows, and provider registry definitions self-clean through host registries.",
        "Destructive purge execution remains host-guarded: backup first, typed confirmation, inactive module, and RequireStepUpForSensitiveActions on the host purge primitive."
    ]
}
